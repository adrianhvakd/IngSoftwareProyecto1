# ============================================================================
# RE/MAX Potosí · variables de entorno
# ============================================================================
# Copia este archivo a `.env` y completa los valores. No subas `.env` al repo.
# Las variables VITE_* se incluyen en el bundle del navegador: usa SOLO la
# clave publicable, nunca la service role.

# URL del proyecto (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave publicable/anon (segura para el navegador)
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-o-anon-key>

# Clave service role: SOLO servidor (scripts, funciones server-side).
# Nunca la prefijes con VITE_ ni la importes desde componentes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Opcional: conexión directa a PostgreSQL para que `pnpm db:seed-users`
# ejecute también supabase/seed.sql. Si no la defines, ejecuta el seed a mano
# en el editor SQL de Supabase.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Opcional: contraseña de las cuentas demo (por defecto RemaxDemo#2026).
# SEED_DEMO_PASSWORD=RemaxDemo#2026
